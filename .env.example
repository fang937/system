# 复制本文件为 .env，再把下面三个 PASSWORD/SECRET 换成你自己的值。
# 用法（Windows PowerShell）：Copy-Item .env.example .env
# 用法（Git Bash / macOS / Linux）：cp .env.example .env
#
# .env 已在 .gitignore 中，不会被提交。不要把它改成别的文件名再提交。

# 前端访问端口（浏览器打开 http://localhost:8089）
WEB_PORT=8089

# 后端接口端口（Docker 部署时对宿主机暴露，便于调试；不用可注释 ports）
API_PORT=8080

# ---- MySQL ----
# 本机 root 密码，填你自己安装 MySQL 时设置的那个
MYSQL_ROOT_PASSWORD=改成你自己的MySQL密码
MYSQL_DATABASE=lab_select_v2
MYSQL_PORT=3306

# ---- JWT ----
# 随便一串 32 位以上的字符即可，本地开发用；上线必须换随机串
JWT_SECRET=change-this-to-a-random-string-at-least-32-chars
JWT_EXPIRE_HOURS=12

# ---- 演示数据 ----
# true：首次启动（users 表为空）自动写入 3 个实训室 / 8 位导师 / 8 名学生
# 演示账号：admin、lab_ai、lab_bd、lab_ns、tutor_zhang、tutor_liu、2023001，密码均为 123456
DEMO_DATA=true

# ---- 构建 ----
NPM_REGISTRY=https://registry.npmmirror.com
JAVA_OPTS=-Xms256m -Xmx512m

# ---- AI 能力（多通道）----
# 任意一把 Key 填上即启用真实模型；某通道额度用完会自动切到下一个
# 优先级：AI_ACTIVE 指定的通道 > 按 openai → deepseek → qwen 顺序
AI_ACTIVE=
AI_QUOTA_COOLDOWN_MINUTES=10

AI_OPENAI_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_MODEL=gpt-4o-mini

AI_DEEPSEEK_KEY=
AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
AI_DEEPSEEK_MODEL=deepseek-chat

AI_QWEN_KEY=
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_QWEN_MODEL=qwen-plus

# 兼容单通道写法（上面都没填时生效）
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# ---- 简历 OCR（PDF 文本层为主，扫描件走 PP-StructureV3 文档解析）----
# 留空则不启用 OCR，扫描件只标注"未解析正文"
#
# 接入飞桨 PaddleOCR 官方在线 API（限时免费）：
#   1. 打开 https://aistudio.baidu.com/paddleocr ，用百度账号登录
#   2. 取访问令牌：我的控制台 → 令牌 → Access Token（切勿外泄）
#   3. 在页面「API 调用」标签里复制属于你自己的地址（每个账号不同）：
#        文档解析(PP-StructureV3) → https://xxxx.aistudio-hub.baidu.com/layout-parsing
#        文字识别(PP-OCRv5)       → https://xxxx.aistudio-hub.baidu.com/ocr
#   4. 填到下面对应变量后重启后端
# 额度：每个模型每天 3000 页，单次最多 100 页；超限返回 429。
#       403=令牌错误 500=参数错误 503=请求过多 504=网关超时
#
# 也可以本地自部署：paddlex --serve --pipeline PP-StructureV3 --port 8080
#   → OCR_STRUCTURE_ENDPOINT=http://127.0.0.1:8080/layout-parsing
OCR_STRUCTURE_ENDPOINT=
OCR_STRUCTURE_API_KEY=
OCR_STRUCTURE_AUTH_SCHEME=token
OCR_STRUCTURE_TABLE=true
OCR_STRUCTURE_TIMEOUT_SECONDS=120
# 普通 OCR 兜底（PP-OCRv5），不配也没关系；鉴权固定为「token <key>」
PADDLEOCR_ENDPOINT=
PADDLEOCR_API_KEY=
# auto：先文档解析再普通 OCR；pp-structure-v3 / ocr / none
OCR_PROVIDER=auto
OCR_MIN_CHARS=60
OCR_MAX_PAGES=5
OCR_RENDER_DPI=150
